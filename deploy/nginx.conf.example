# Put this map in the `http {}` block of nginx.conf, outside any server block.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream broadcaster_app {
    server 127.0.0.1:8080;
    keepalive 16;
}

upstream broadcaster_livekit {
    server 127.0.0.1:7880;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name stream.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name stream.example.com;

    # Replace these paths with your existing certificate files.
    ssl_certificate     /etc/letsencrypt/live/stream.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stream.example.com/privkey.pem;

    # LiveKit signaling. The trailing slash on proxy_pass is intentional:
    # /livekit/rtc is forwarded to LiveKit as /rtc.
    location ^~ /livekit/ {
        proxy_pass http://broadcaster_livekit/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    # STUN uses UDP 3478 directly on the app host. Nginx does not proxy it;
    # expose/forward UDP 3478 in the host firewall and NAT instead.
    # React application and Go API.
    location / {
        proxy_pass http://broadcaster_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
