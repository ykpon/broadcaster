# No .env is needed for localhost: docker compose up --build
# Public deployment: copy to .env and fill in all values below.
APP_URL=https://stream.example.com
SITE_ADDRESS=stream.example.com
LIVEKIT_URL=wss://stream.example.com/livekit
# Public IPv4 of the Docker host (not its container IP).
LIVEKIT_NODE_IP=203.0.113.10
LIVEKIT_API_KEY=replace-with-random-key
LIVEKIT_API_SECRET=replace-with-unique-random-secret-at-least-32-characters
